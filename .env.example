# HenrikDev unofficial Valorant API key.
# Get one at https://api.henrikdev.xyz/dashboard/ after joining their Discord.
# Basic tier (30 req/min) is issued instantly and is plenty for Phase 1.
HENRIK_API_KEY=HDEV-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Your Riot ID, split. For "PlayerOne#NA1" that is RIOT_NAME=PlayerOne, RIOT_TAG=NA1.
RIOT_NAME=
RIOT_TAG=

# Affinity / region: eu, na, ap, kr, latam, br
RIOT_REGION=eu

# Where the SQLite file lives (relative paths resolve against the repo root).
DB_PATH=data/clipsvalorant.db

# Twitch application credentials, from https://dev.twitch.tv/console/apps
# Registering an app requires 2FA on the Twitch account.
# Only an app access token is needed - no user login, no scopes.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
