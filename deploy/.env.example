# The deployed machine's environment. Copy to `.env` on the VM and fill in.
# `.env` is gitignored: these are secrets and they stay on that machine.
#
#   cp .env.example .env && nano .env
#
# docker-compose.yml reads this for the app, and substitutes SITE_HOST into
# the Caddyfile.

# ---------------------------------------------------------------- the site

# The hostname Caddy gets a certificate for. Must already resolve to this
# machine before the stack starts, or Let's Encrypt will refuse.
SITE_HOST=valgrind.duckdns.org

# DuckDNS, so the hostname follows the machine. Token from duckdns.org after
# signing in. DUCKDNS_DOMAIN is just the label - for valgrind.duckdns.org it
# is `valgrind`, not the whole name.
DUCKDNS_DOMAIN=valgrind
DUCKDNS_TOKEN=

# ---------------------------------------------------------------- the keys

# HenrikDev, from https://api.henrikdev.xyz/dashboard/
HENRIK_API_KEY=

# Twitch application, from https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ------------------------------------------------------------- the gate

# One shared password for the page. SET THIS. The machine is on a public
# hostname, and without it anyone who finds the URL spends your HenrikDev
# quota and can read whose matches have been scanned. Any username works.
CLIPS_PASSWORD=

# ------------------------------------------------- the server's own account

# The Riot ID the server shows by default. Visitors type their own, so this
# only decides what an empty page falls back to. RIOT_REGION is a default
# too: _correct_region asks HenrikDev which shard an ID actually plays on and
# overrides this, so a visitor on another server is found regardless.
RIOT_NAME=
RIOT_TAG=
RIOT_REGION=eu
